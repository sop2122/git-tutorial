# ─── 서버 ───────────────────────────────────────────────
PORT=3000

# ─── 채널톡 Open API ────────────────────────────────────
# 채널톡 관리자 > 설정 > 보안/개발 > API 액세스 키 에서 발급
CHANNELTALK_ACCESS_KEY=your-access-key
CHANNELTALK_ACCESS_SECRET=your-access-secret
# Webhook 요청 검증용 시크릿 (채널톡 Webhook 등록 시 설정)
CHANNELTALK_WEBHOOK_SECRET=your-webhook-signing-secret
# 봇/매니저로 답장 보낼 때 표시할 이름
CHANNELTALK_BOT_NAME=CS봇

# ─── Claude API ─────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-4-8

# ─── Slack ──────────────────────────────────────────────
# Bot User OAuth Token (xoxb-...) — chat:write 권한 필요
SLACK_BOT_TOKEN=xoxb-...
# 고객 문의를 게시할 채널 ID (예: C0123456789)
SLACK_CHANNEL_ID=C0123456789
# Slack 요청(버튼 클릭) 검증용 Signing Secret
SLACK_SIGNING_SECRET=your-slack-signing-secret
